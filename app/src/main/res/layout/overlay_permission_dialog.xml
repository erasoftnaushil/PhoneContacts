<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_20sdp"
    android:background="@drawable/round_bg_white"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_15sdp">

        <ImageView
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:padding="@dimen/_5sdp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/SettingsTextLabelStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:textColor="@color/black"
            android:lineSpacingExtra="@dimen/_3sdp"
            android:text="Grant Overlay Permission for Phone Contacts"
            android:textSize="@dimen/_15sdp" />
    </LinearLayout>

    <TextView
        style="@style/SettingsTextValueStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginEnd="@dimen/_20sdp"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_7sdp"
        android:lineSpacingExtra="@dimen/_5sdp"
        android:text="To make sure you can view contact details and manage your calls even when your phone is locked or you're using another app, we need permission to display the contact screen over other apps. Without this, you might miss important contact information or calls."
        android:textSize="@dimen/_12sdp" />

    <TextView
        android:id="@+id/enableBtn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="end"
        android:layout_marginStart="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_30sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:background="@drawable/bg_btn_permission"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_30sdp"
        android:text="Allow"
        android:textColor="@color/whiteFinal"
        android:textSize="@dimen/_14sdp" />

</LinearLayout>
