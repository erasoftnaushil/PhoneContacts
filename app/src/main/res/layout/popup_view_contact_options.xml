<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_contact_options_card"
    android:layout_width="175dp"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/menu_item_favorites"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_favorites"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_outline_vector"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/favorites_menu"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_delete"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_delete"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_delete_outline_vector"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/delete"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_share"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_share"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_share_vector"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/share"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
