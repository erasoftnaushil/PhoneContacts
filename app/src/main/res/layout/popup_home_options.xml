<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_options_card"
    android:layout_width="205dp"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/menu_item_groups"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_groups"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_groups"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_groups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/groups"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_all_calls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_all_calls"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_all_calls"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_all_calls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/menu_all_calls"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_outgoing_calls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_outgoing_calls"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_outgoing_calls"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_outgoing_calls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/menu_outgoing_calls"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_incoming_calls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_incoming_calls"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_incoming_calls"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_incoming_calls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/menu_incoming_calls"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_missed_calls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_missed_calls"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_missed_calls"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_missed_calls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/menu_missed_calls"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_blocked_calls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_blocked_calls"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu_blocked_calls"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_blocked_calls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/menu_blocked_calls"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_item_settings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/menu_icon_settings"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_settings_cog_vector"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/menu_text_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif"
            android:text="@string/settings"
            android:textColor="@color/home_item_title_text"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
