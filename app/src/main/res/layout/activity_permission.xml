<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">


    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/_25sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/clsdk_font_regular"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_6sdp"
            android:text="@string/pp_app_name"
            android:textColor="@color/black"
            android:textSize="@dimen/_21sdp"
            app:fontFamily="@font/miranda_sans_regular" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/miranda_sans_regular"
            android:gravity="center"
            android:text="Everything you need, beautifully simple"
            android:textColor="@color/save_summry"
            android:textSize="@dimen/_11sdp" />

    </LinearLayout>

    <!--  <org.fossify.commons.views.MyTextView
          android:id="@+id/title"
          style="@style/SettingsTextLabelStyle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/_15sdp"
          android:layout_marginTop="@dimen/_40sdp"
          android:layout_marginEnd="@dimen/_15sdp"
          android:gravity="center"
          android:text="Phone Contact required \nthese permissions"
          android:textColor="@color/black"
          android:textSize="@dimen/_18sdp" />-->


    <LinearLayout
        android:id="@+id/linearTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomLayout"
        android:layout_below="@+id/llHeader"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="vertical"
        android:padding="@dimen/_5sdp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_gravity="top"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/icn_per_notification" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notification"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_15sdp" />

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextValueStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:lineSpacingExtra="@dimen/_3sdp"
                            android:text="We request notification access to send timely updates and alerts."
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_26sdp"
                    android:orientation="horizontal">


                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="top"
                        android:padding="@dimen/_2sdp"
                        android:src="@drawable/icn_per_phone"
                        app:tint="@color/save_summry" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miranda_sans_medium"
                            android:text="Phone Status"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_15sdp" />

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextValueStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/miranda_sans_regular"
                            android:lineSpacingExtra="@dimen/_3sdp"
                            android:text="This lets us show an 'After Call' screen for a smoother experience. No call info is collected or shared."
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="top"
                        android:padding="@dimen/_1sdp"
                        android:src="@drawable/ic_view_contact_details_vector"
                        app:tint="@color/save_summry" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miranda_sans_medium"
                            android:text="Read Contacts"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_15sdp" />

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextValueStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/miranda_sans_regular"
                            android:lineSpacingExtra="@dimen/_3sdp"
                            android:text="We need permission to read your contacts and display relevant information for contact app."
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/llNotificationPer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="top"
                        android:padding="@dimen/_2sdp"
                        android:src="@drawable/ic_notifications_24"
                        app:tint="@color/save_summry" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextLabelStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miranda_sans_medium"
                            android:text="Notification"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_15sdp" />

                        <org.fossify.commons.views.MyTextView
                            style="@style/SettingsTextValueStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/miranda_sans_regular"
                            android:lineSpacingExtra="@dimen/_3sdp"
                            android:text="Allow notifications so you never miss important reminders and alerts."
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <RelativeLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <RelativeLayout
            android:id="@+id/llBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_85sdp"
            android:layout_marginBottom="@dimen/_5sdp">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                app:cardBackgroundColor="#42B044"
                app:cardCornerRadius="@dimen/_26sdp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/txtGetStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/miranda_sans_semi_bold"
                        android:includeFontPadding="false"
                        android:text="Agree &amp; Continue"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_15sdp" />

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_20sdp"
                        android:padding="@dimen/_2sdp"
                        android:rotation="180"
                        app:tint="#ffffff"
                        android:src="@drawable/ic_arrow_left_vector" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/_30sdp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/click" />

        </RelativeLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/tvPrivacydesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/llBtn"
            android:layout_marginBottom="@dimen/_20sdp"
            android:fontFamily="@font/miranda_sans_medium"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_3sdp"
            android:text="@string/text_privacy_desc_2"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp" />
    </RelativeLayout>


</RelativeLayout>
