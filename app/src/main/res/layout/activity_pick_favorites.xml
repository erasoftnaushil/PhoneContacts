<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pick_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/pick_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="13dp"
            android:src="@drawable/ic_arrow_left_vector"
            app:tint="@color/home_item_title_text" />

        <TextView
            android:id="@+id/pick_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pick_contact"
            android:textColor="@color/home_item_title_text"
            android:textSize="19sp" />

        <EditText
            android:id="@+id/pick_search_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:hint="@string/search_contacts"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/home_item_title_text"
            android:textColorHint="@color/home_search_hint"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/pick_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:padding="13dp"
            android:src="@drawable/ic_search_vector"
            app:tint="@color/home_item_title_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pick_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/pick_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/home_item_subtitle_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/pick_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/home_item_divider" />

    <include
        android:id="@+id/pick_bar"
        layout="@layout/layout_cancel_save_bar" />

</LinearLayout>
