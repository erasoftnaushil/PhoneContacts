<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/btn_view"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_6sdp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:text="New File Detected New File Detect Detect Detect Detect"
            android:textSize="14dp"
            android:textStyle="bold" />

    </LinearLayout>

    <ViewFlipper
        android:id="@+id/btn_view"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:autoStart="true"
        android:flipInterval="200"
        android:inAnimation="@anim/shake_notification"
        android:paddingHorizontal="@dimen/_6sdp">

        <!-- Frame 1 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@drawable/bg_onboarding_notification_button_green"
                android:gravity="center"
                android:text="Open"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Frame 2 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@drawable/bg_onboarding_notification_button_green"
                android:gravity="center"
                android:text="Open"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </ViewFlipper>

</RelativeLayout>
